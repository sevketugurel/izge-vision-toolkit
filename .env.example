IZGE_APP_NAME=İzge
POSTGRES_PASSWORD=izge-local
# Local development only (Compose overrides the database host).
DATABASE_URL=postgresql+psycopg://izge:izge-local@127.0.0.1:5432/izge
MEDIA_ROOT=media
MAX_UPLOAD_BYTES=2147483648
EVIDENCE_RETENTION_DAYS=90
# Optional RTSP adapter only; never return credential URLs from the API.
# IZGE_RTSP_CAMERA_1=rtsp://user:password@camera/stream
# Gated Hugging Face weights for facebook/dinov3-vits16-pretrain-lvd1689m (accept the license first).
HF_TOKEN=
# Camera crop configs (YAML/JSON), separated by ':'. Compose mounts ./config/cameras.
# IZGE_CAMERA_CONFIG_DIRS=/app/config/cameras
# Optional: require 'Authorization: Bearer <token>' on /api/* (except /api/health). The bundled UI does not send it.
# IZGE_API_TOKEN=
